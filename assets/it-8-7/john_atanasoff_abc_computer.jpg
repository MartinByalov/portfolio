<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" width="100%" height="100%">
  <defs>
    <linearGradient id="bgG" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="100%" stop-color="#1e293b"/>
    </linearGradient>
    <linearGradient id="glowG" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#ef4444"/>
      <stop offset="100%" stop-color="#f59e0b"/>
    </linearGradient>
  </defs>
  <rect width="800" height="450" fill="url(#bgG)"/>
  
  <rect x="150" y="50" width="500" height="300" rx="10" fill="#1e293b" stroke="#38bdf8" stroke-width="3"/>
  <text x="400" y="90" fill="#38bdf8" font-family="sans-serif" font-size="22" font-weight="bold" text-anchor="middle">Компютър ABC (Atanasoff-Berry Computer)</text>
  
  <g transform="translate(200, 120)">
    <circle cx="40" cy="50" r="20" fill="url(#glowG)"/>
    <circle cx="120" cy="50" r="20" fill="url(#glowG)"/>
    <circle cx="200" cy="50" r="20" fill="url(#glowG)"/>
    <circle cx="280" cy="50" r="20" fill="url(#glowG)"/>
    <circle cx="360" cy="50" r="20" fill="url(#glowG)"/>
    <text x="200" y="100" fill="#cbd5e1" font-family="sans-serif" font-size="14" text-anchor="middle">~300 Вакуумни електронни лампи</text>
  </g>
  
  <g transform="translate(250, 240)">
    <rect x="0" y="0" width="300" height="60" rx="30" fill="#334155" stroke="#f59e0b" stroke-width="2"/>
    <text x="150" y="36" fill="#fef3c7" font-family="sans-serif" font-size="15" font-weight="bold" text-anchor="middle">Въртящ се кондензаторен барабан (Памет)</text>
  </g>

  <text x="400" y="400" fill="#f17a3e" font-family="sans-serif" font-size="18" font-weight="bold" text-anchor="middle">Джон Атанасов &amp; Клифърд Бери (1937 - 1942 г.)</text>
</svg>
