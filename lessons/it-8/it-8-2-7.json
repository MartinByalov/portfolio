        {
          "id": "section-glossary",
          "title": "Речник",
          "tone": "dark",
          "icon": "fas fa-book-bookmark",
          "defaultOpen": false,
          "content": [
            {
              "type": "glossary-list",
              "id": "glossary-it-8-2-7",
              "items": [
                {
                  "term": "Хардуер",
                  "definition": "Физическите компоненти на компютърната система."
                },
                {
                  "term": "Софтуер",
                  "definition": "Програми и инструкции, които управляват хардуера."
                },
                {
                  "term": "Данни",
                  "definition": "Информацията, която компютърът въвежда, обработва и съхранява."
                },
                {
                  "term": "Операционна система",
                  "definition": "Софтуер, който управлява хардуера, приложенията и достъпа на потребителя."
                },
                {
                  "term": "Драйвер",
                  "definition": "Програма, която позволява на операционната система да управлява конкретно устройство."
                },
                {
                  "term": "Plug-and-Play",
                  "definition": "Технология, при която операционната система автоматично разпознава и настройва ново свързано устройство."
                },
                {
                  "term": "SoC (System on Chip)",
                  "definition": "Чип, обединяващ процесор, графичен ускорител и модем в едно мобилно устройство."
                },
                {
                  "term": "Поколение мрежа (G)",
                  "definition": "Етап в развитието на клетъчните комуникации - например 3G, 4G, 5G."
                },
                {
                  "term": "Порт",
                  "definition": "Физически интерфейс за свързване на периферно устройство към компютъра."
                },
                {
                  "term": "Периферно устройство",
                  "definition": "Външно устройство, свързано с компютъра за вход, изход, съхранение или комуникация."
                },
                {
                  "term": "Тактова честота",
                  "definition": "Брой работни цикли на процесора за секунда, измерена в GHz."
                },
                {
                  "term": "Архитектура на фон Нойман",
                  "definition": "Принцип, при който програмата и данните се съхраняват заедно в паметта."
                }
              ]
            }
          ]
        }
      ]
    }
