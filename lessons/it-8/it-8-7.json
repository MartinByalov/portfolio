              "type": "glossary-list",
              "id": "glossary",
              "items": [
                {
                  "term": "Абак",
                  "definition": "Древно устройство за извършване на изчисления с помощта на мъниста или камъчета."
                },
                {
                  "term": "Перфокарта",
                  "definition": "Карта с отвори, използвана за записване и въвеждане на данни или инструкции."
                },
                {
                  "term": "Двоична бройна система",
                  "definition": "Бройна система, използваща само 0 и 1."
                },
                {
                  "term": "Реле",
                  "definition": "Електромеханичен превключвател, използван в ранните електромеханични компютри."
                },
                {
                  "term": "Архитектура на фон Нойман",
                  "definition": "Принцип, при който програмата и данните се съхраняват в паметта."
                },
                {
                  "term": "Поколение компютри",
                  "definition": "Разграничаване на компютрите според основната технология, с която са изградени."
                }
              ]
            }
